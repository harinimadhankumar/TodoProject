{
  "buildCommand": "npm run build",
  "outputDirectory": "Frontend",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "cache-control": "public, max-age=3600, immutable"
      }
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/$1.html",
      "headers": {
        "cache-control": "public, max-age=600"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200,
      "headers": {
        "cache-control": "public, max-age=600"
      }
    }
  ],
  "env": {
    "API_URL": "@api_url"
  },
  "git": {
    "deploymentEnabled": true
  }
}
